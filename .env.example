# PostgreSQL connection string.
# Locally: point this at a local Postgres instance, e.g.
#   postgresql://postgres:postgres@localhost:5432/contact_manager
# In production (Vercel): use the connection string from your Postgres
# provider (Neon, Vercel Postgres, Supabase, etc.). It usually looks like:
#   postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# Some providers (e.g. Vercel Postgres / Neon via the Vercel integration)
# expose the connection string as POSTGRES_URL instead. Either name works —
# lib/db.ts reads POSTGRES_URL first, then falls back to DATABASE_URL.
# POSTGRES_URL=

# Base URL of the contact assistant agent-service.
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000
